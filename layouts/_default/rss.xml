{{- $pages := .RegularPages -}}
{{- if .IsHome -}}
  {{- $pages = site.RegularPages -}}
{{- else if not .IsSection -}}
  {{- $pages = .Pages -}}
{{- end -}}
{{- $pages = where $pages "Section" "ne" "people" -}}
{{- $title := printf "%s on %s" (partial "page-title.html" .) site.Title -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ $title }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content in {{ $title }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>{{ end }}
    {{ range $pages }}
      <item>
        <title>{{ partial "page-title.html" . }}</title>
        <link>{{ .Permalink }}</link>
        <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
        <guid>{{ .Permalink }}</guid>
        <description>{{ .Summary | html }}</description>
      </item>
    {{ end }}
  </channel>
</rss>
